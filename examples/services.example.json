{
  "services": [
    {
      "id": "gateway",
      "name": "网关",
      "kind": "systemd",
      "target": "nginx.service",
      "description": "对外提供 80/443 的 nginx 网关。",
      "order": 10,
      "nginx": true,
      "actions": [
        "reload",
        "restart",
        "start",
        "stop"
      ],
      "health": {
        "type": "http",
        "url": "http://127.0.0.1:8083/__status",
        "expect": [
          200
        ]
      },
      "logs": [
        {
          "id": "journal",
          "type": "journal",
          "label": "服务日志"
        }
      ]
    },
    {
      "id": "crproxy-local",
      "name": "Docker 镜像代理",
      "kind": "docker",
      "target": "node-warden-crproxy",
      "description": "本地 crproxy，监听 127.0.0.1:8080。",
      "order": 20,
      "actions": [
        "restart",
        "start",
        "stop"
      ],
      "health": {
        "type": "http",
        "url": "http://127.0.0.1:8080/v2/",
        "expect": [
          200
        ]
      },
      "logs": [
        {
          "id": "docker",
          "type": "docker",
          "label": "容器日志"
        }
      ]
    },
    {
      "id": "crproxy-front",
      "name": "镜像代理前置",
      "kind": "docker",
      "target": "node-warden-crproxy-front",
      "description": "处理 OCI referrers 请求并转发到 crproxy。",
      "order": 30,
      "nginx": true,
      "actions": [
        "restart",
        "start",
        "stop",
        "test",
        "reload"
      ],
      "health": {
        "type": "http",
        "url": "http://127.0.0.1:8081/v2/",
        "expect": [
          200
        ]
      },
      "logs": [
        {
          "id": "docker",
          "type": "docker",
          "label": "容器日志"
        }
      ]
    },
    {
      "id": "ghproxy",
      "name": "GitHub 下载代理",
      "kind": "systemd",
      "target": "node-warden-ghproxy.service",
      "description": "为 GitHub release、raw 和 clone 提供下载代理。",
      "order": 40,
      "actions": [
        "restart",
        "start",
        "stop"
      ],
      "health": {
        "type": "http",
        "url": "http://127.0.0.1:8082/__stats",
        "expect": [
          200
        ]
      },
      "logs": [
        {
          "id": "journal",
          "type": "journal",
          "label": "服务日志"
        }
      ]
    },
    {
      "id": "certbot",
      "name": "证书续期定时器",
      "kind": "systemd",
      "target": "certbot.timer",
      "description": "Let's Encrypt 证书续期定时器。",
      "order": 60,
      "actions": [
        "start",
        "stop",
        "restart"
      ],
      "health": {
        "type": "none"
      },
      "logs": [
        {
          "id": "letsencrypt",
          "type": "file",
          "path": "/var/log/letsencrypt/letsencrypt.log",
          "label": "certbot 日志"
        }
      ]
    }
  ],
  "backups": [
    {
      "id": "panel-config",
      "label": "Node Warden 配置",
      "path": "/etc/node-warden"
    },
    {
      "id": "gateway-config",
      "label": "nginx 网关配置",
      "path": "/etc/nginx/conf.d/node-warden.conf"
    },
    {
      "id": "crproxy-front-config",
      "label": "镜像代理前置配置",
      "path": "/etc/node-warden/crproxy-front.conf"
    },
    {
      "id": "ghproxy",
      "label": "GitHub 代理文件",
      "path": "/opt/node-warden-ghproxy"
    },
    {
      "id": "systemd-units",
      "label": "systemd 单元",
      "path": "/etc/systemd/system/node-warden.service"
    }
  ]
}
